<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!--
      Prerelease builds of DurableFunctionsMonitor.DotNetIsolated[.MsSql|.Netherite] are pushed
      here by .github/workflows/main-build.yml. GitHub Packages always requires authentication,
      even for public repos, so restoring from it needs credentials.

      In CI this is handled automatically (GITHUB_TOKEN is injected by the workflow). Locally,
      create a classic PAT with the 'read:packages' scope and register it against this source
      with "dotnet nuget update source", passing your GitHub username and the PAT.

      Until you actually need the prerelease feed you can leave this source unauthenticated;
      restore only consults it for package ids it cannot find on nuget.org.
    -->
    <add key="github-durablefunctionsmonitor" value="https://nuget.pkg.github.com/ViswanathBalusu/index.json" protocolVersion="3" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <!--
      DurableFunctionsMonitor.* is claimed by BOTH sources on purpose: released versions live on
      nuget.org, prereleases on GitHub Packages. Dropping the nuget.org claim would break
      custom-backends/dotnetIsolated, which restores a released DurableFunctionsMonitor.DotNetIsolated.
    -->
    <packageSource key="github-durablefunctionsmonitor">
      <package pattern="DurableFunctionsMonitor.*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
